# Environment Variables
NODE_ENV=development
PORT=5000

# Database (NeonDB PostgreSQL)
DATABASE_URL="postgresql://username:password@ep-xxx-pooler.us-east-1.aws.neon.tech/supermart?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://username:password@ep-xxx.us-east-1.aws.neon.tech/supermart?sslmode=require"

# JWT Secrets (use strong random strings in production)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# OTP (Mock - in-memory for development)
OTP_EXPIRY_MINUTES=10
