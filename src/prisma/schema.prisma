generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// USER MODELS
// ============================================================

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  email        String    @unique
  phone        String    @unique
  passwordHash String
  role           Role      @default(USER)
  profileImage   String?
  expoPushToken  String?
  isVerified     Boolean   @default(false)
  isActive       Boolean   @default(true)
  lastLogin      DateTime?

  // Relations
  orders        Order[]
  staffProfile  Staff?
  adminProfile  Admin?
  reviews       Review[]
  cart          Cart?
  notifications Notification[]
  products      Product[]
  addresses           Address[]
  wishlists           Wishlist[]
  savedPaymentMethods SavedPaymentMethod[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum Role {
  USER
  STAFF
  ADMIN
}

// ============================================================
// ADDRESS MODEL
// ============================================================

model Address {
  id           String  @id @default(uuid()) @db.Uuid
  userId       String  @db.Uuid
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String  // "Home", "Office", etc.
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  area         String
  postalCode   String?
  isDefault    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

// ============================================================
// STAFF MODEL
// ============================================================

model Staff {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @unique @db.Uuid
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffId         String        @unique
  position        StaffPosition
  joiningDate     DateTime      @default(now())
  salary          Float?
  shift           Shift?
  assignedArea    String[]
  rating          Float         @default(0)
  totalDeliveries Int           @default(0)
  earnings        Float         @default(0)
  isAvailable     Boolean       @default(true)

  attendance Attendance[]
  deliveries Order[]      @relation("assignedOrders")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("staff")
}

enum StaffPosition {
  DELIVERY_BOY
  SUPPORT
  WAREHOUSE
  MANAGER
}

enum Shift {
  MORNING
  EVENING
  NIGHT
}

model Attendance {
  id      String           @id @default(uuid()) @db.Uuid
  staffId String           @db.Uuid
  staff   Staff            @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date    DateTime         @default(now())
  checkIn DateTime
  checkOut DateTime?
  status  AttendanceStatus @default(PRESENT)

  createdAt DateTime @default(now())

  @@map("attendance")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  LATE
}

// ============================================================
// ADMIN MODEL
// ============================================================

model Admin {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions String[]
  superAdmin  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

// ============================================================
// PRODUCT MODEL
// ============================================================

model Product {
  id            String  @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  price         Float
  discountPrice Float?
  category      String
  brand         String?
  stock         Int     @default(0)
  images        String[]
  rating        Float   @default(0)
  ratingCount   Int     @default(0)
  isActive      Boolean @default(true)
  createdBy     String  @db.Uuid
  createdUser   User    @relation(fields: [createdBy], references: [id])

  orderItems OrderItem[]
  reviews    Review[]
  cartItems  CartItem[]
  wishlists  Wishlist[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([name])
  @@map("products")
}

// ============================================================
// CART MODELS
// ============================================================

model Cart {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @unique @db.Uuid
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CartItem[]
  totalAmount Float      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("carts")
}

model CartItem {
  id        String  @id @default(uuid()) @db.Uuid
  cartId    String  @db.Uuid
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  price     Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@map("cart_items")
}

// ============================================================
// ORDER MODELS
// ============================================================

model Order {
  id                 String      @id @default(uuid()) @db.Uuid
  orderId            String      @unique
  userId             String      @db.Uuid
  user               User        @relation(fields: [userId], references: [id])
  items              OrderItem[]
  totalAmount        Float
  discount           Float         @default(0)
  deliveryCharge     Float         @default(0)
  status             OrderStatus   @default(PENDING)
  paymentMethod      PaymentMethod @default(COD)
  paymentStatus      PaymentStatus @default(PENDING)
  transactionId      String?
  deliveryAddress    Json
  assignedStaffId    String?     @db.Uuid
  assignedStaff      Staff?      @relation("assignedOrders", fields: [assignedStaffId], references: [id])
  deliveredAt        DateTime?
  cancellationReason String?
  returnReason       String?
  returnDetails      String?
  returnImages       String[]
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([userId])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentMethod {
  COD
  BKASH
  ROCKET
  NOGOD
  BANK_TRANSFER
  CARD
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @db.Uuid
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float

  @@map("order_items")
}

// ============================================================
// REVIEW MODEL
// ============================================================

model Review {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @db.Uuid
  user      User    @relation(fields: [userId], references: [id])
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])
  rating    Int
  comment   String?
  images    String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@map("reviews")
}

// ============================================================
// NOTIFICATION MODEL
// ============================================================

model Notification {
  id      String  @id @default(uuid()) @db.Uuid
  userId  String  @db.Uuid
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title   String
  message String
  type    String
  isRead  Boolean @default(false)
  data    Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}

// ============================================================
// WISHLIST MODEL
// ============================================================

model Wishlist {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("wishlists")
}

// ============================================================
// SAVED PAYMENT METHOD MODEL
// ============================================================

model SavedPaymentMethod {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "CARD", "MOBILE_BANKING"
  provider  String   // "VISA", "MASTERCARD", "BKASH", "ROCKET"
  last4     String?  // Last 4 digits of card or phone number
  isDefault Boolean  @default(false)
  details   Json?    // Any extra metadata

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("saved_payment_methods")
}
